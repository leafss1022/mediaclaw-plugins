{
  "id": "douban-coming-notice",
  "name": "豆瓣将映魔改版",
  "description": "监控豆瓣即将开播电视剧，想看人数达阈值自动建订阅，开播前发送提醒。",
  "author": "luanyi143",
  "license": "MIT",
  "version": "1.0.0",
  "category": "subscription",
  "min_app_version": "0.8.1",
  "api_range": {"min": 2, "max": 2},
  "extension_points": ["scheduler.task"],
  "permissions": {
    "scheduler": true,
    "network": ["*"],
    "media": true,
    "subscription": true,
    "library": true,
    "notify": true
  },
  "settings": {
    "type": "object",
    "properties": {
      "rsshub": {"type": "string", "default": "https://rsshub.ddsrem.com", "title": "RSSHub 地址"},
      "sort_by": {"type": "string", "enum": ["hot", "time"], "default": "hot", "title": "排序方式"},
      "count": {"type": "integer", "default": 10, "title": "请求数量"},
      "wish_count_threshold": {"type": "integer", "default": 5000, "title": "想看人数阈值"},
      "advance_days": {"type": "integer", "default": 7, "title": "提前订阅天数"},
      "notify_before_air": {"type": "boolean", "default": true, "title": "开播前提醒"},
      "notify_hours": {"type": "integer", "default": 24, "title": "提醒提前小时数"},
      "cron": {"type": "string", "default": "0 8 * * *", "title": "执行周期（cron）"}
    }
  }
}
