{
  "id": "media-cover-generator",
  "name": "媒体库封面生成",
  "description": "使用媒体库最近入库的本地海报生成横向封面，配置界面按 MoviePilot 封面图插件适配。",
  "author": "Mediaclaw",
  "license": "MIT",
  "version": "0.1.0",
  "category": "tool",
  "icon": null,
  "entry": "main.py",
  "min_app_version": "0.13.0",
  "api_range": {"min": 3, "max": 3},
  "extension_points": ["scheduler.task", "webui.panel"],
  "permissions": {
    "scheduler": true,
    "library": true
  },
  "settings": {
    "type": "object",
    "properties": {
      "enabled": {"type": "boolean", "default": true, "title": "启用插件"},
      "update_now": {"type": "boolean", "default": false, "title": "立即更新封面"},
      "transfer_monitor": {"type": "boolean", "default": false, "title": "入库监控"},
      "delay": {"type": "integer", "default": 60, "title": "入库延迟（秒）"},
      "selected_servers": {"type": "array", "default": [], "title": "媒体服务器"},
      "sort_by": {"type": "string", "enum": ["Random", "DateCreated", "PremiereDate"], "default": "Random", "title": "封面来源排序"},
      "cron": {"type": "string", "default": "0 6 * * *", "title": "定时更新封面"},
      "library_id": {"type": "integer", "default": 0, "title": "媒体库 ID", "description": "兼容旧配置，0 表示处理全部媒体库。"},
      "include_libraries": {"type": "array", "default": [], "title": "更新媒体库"},
      "cover_style": {"type": "string", "enum": ["static_1", "static_2", "static_3", "static_4"], "default": "static_1", "title": "封面风格"},
      "cover_style_base": {"type": "string", "enum": ["static_1", "static_2", "static_3", "static_4"], "default": "static_1", "title": "封面基础风格"},
      "cover_style_variant": {"type": "string", "enum": ["static", "animated"], "default": "static", "title": "输出类型"},
      "style": {"type": "string", "enum": ["static_1", "static_2", "static_3", "static_4"], "default": "static_1", "title": "封面风格（兼容）"},
      "use_primary": {"type": "boolean", "default": true, "title": "选图优先来源"},
      "multi_1_blur": {"type": "boolean", "default": true, "title": "九宫格背景"},
      "resolution": {"type": "string", "enum": ["1080p", "720p", "480p", "custom"], "default": "1080p", "title": "静态分辨率"},
      "custom_width": {"type": "integer", "default": 1920, "title": "自定义宽度"},
      "custom_height": {"type": "integer", "default": 1080, "title": "自定义高度"},
      "custom_bg_color": {"type": "string", "default": "", "title": "自定义背景色"},
      "animation_duration": {"type": "number", "default": 6, "title": "动画循环周期（秒）"},
      "animation_fps": {"type": "integer", "default": 24, "title": "帧率（FPS）"},
      "animation_format": {"type": "string", "enum": ["gif", "webp"], "default": "gif", "title": "输出格式"},
      "animation_reduce_colors": {"type": "string", "enum": ["auto", "quality", "size"], "default": "auto", "title": "颜色压缩等级"},
      "animated_2_image_count": {"type": "integer", "default": 6, "title": "样式1/2 图片数量"},
      "animated_2_departure_type": {"type": "string", "enum": ["fly", "fade", "crossfade"], "default": "fly", "title": "样式1动画风格"},
      "animation_scroll": {"type": "string", "enum": ["down", "up", "alternate", "alternate_reverse"], "default": "down", "title": "样式3滚动方向"},
      "title_config": {"type": "string", "default": "电影:\n  - MOVIES\n  - 精选影片\n  - \"#B5845C\"", "title": "中英标题配置"},
      "covers_input": {"type": "string", "default": "", "title": "自定义图片目录"},
      "covers_output": {"type": "string", "default": "", "title": "历史封面保存目录"},
      "save_recent_covers": {"type": "boolean", "default": true, "title": "保存最近生成的封面"},
      "covers_history_limit_per_library": {"type": "integer", "default": 10, "title": "媒体库历史封面数量"},
      "covers_page_history_limit": {"type": "integer", "default": 50, "title": "历史封面显示数量"},
      "zh_font_preset": {"type": "string", "enum": ["default", "source_han_sans", "alimama_fangyuan", "zcool_kuaile", "custom"], "default": "default", "title": "主标题字体预设"},
      "en_font_preset": {"type": "string", "enum": ["default", "source_han_sans", "alimama_fangyuan", "zcool_kuaile", "custom"], "default": "default", "title": "副标题字体预设"},
      "zh_font_custom": {"type": "string", "default": "", "title": "自定义主标题字体"},
      "en_font_custom": {"type": "string", "default": "", "title": "自定义副标题字体"},
      "zh_font_size": {"type": "integer", "default": 180, "title": "主标题字体大小"},
      "en_font_size": {"type": "integer", "default": 75, "title": "副标题字体大小"},
      "blur_size": {"type": "integer", "default": 50, "title": "背景模糊尺寸"},
      "color_ratio": {"type": "number", "default": 0.8, "title": "背景颜色混合占比"},
      "title_scale": {"type": "number", "default": 1.0, "title": "标题整体缩放"},
      "zh_font_offset": {"type": "integer", "default": 0, "title": "主标题偏移量"},
      "title_spacing": {"type": "integer", "default": 40, "title": "主副标题间距"},
      "en_line_spacing": {"type": "integer", "default": 40, "title": "副标题行间距"},
      "clean_images": {"type": "boolean", "default": false, "title": "清理封面图片缓存"},
      "clean_fonts": {"type": "boolean", "default": false, "title": "清理字体缓存"}
    }
  }
}
