{
  "id": "media-cover-generator",
  "name": "媒体库封面生成",
  "description": "为 MediaClaw 内置媒体库生成并应用封面：四种静态风格、批量选择、定时刷新和生成记录。",
  "author": "MediaClaw",
  "license": "MIT",
  "version": "0.1.2",
  "entry": "main.py",
  "category": "tool",
  "icon": null,
  "min_app_version": "0.29.1",
  "api_range": {
    "min": 3,
    "max": 3
  },
  "extension_points": [
    "scheduler.task",
    "webui.panel"
  ],
  "permissions": {
    "scheduler": true,
    "library": true
  },
  "settings": {
    "type": "object",
    "properties": {
      "include_libraries": {
        "type": "array",
        "items": {
          "type": "integer",
          "minimum": 1
        },
        "uniqueItems": true,
        "default": [],
        "title": "内置媒体库",
        "description": "留空表示全部内置媒体库。"
      },
      "cover_style": {
        "type": "string",
        "enum": [
          "static_1",
          "static_2",
          "static_3",
          "static_4"
        ],
        "default": "static_1",
        "title": "封面风格"
      },
      "replace_custom": {
        "type": "boolean",
        "default": false,
        "title": "替换手动上传的封面",
        "description": "默认保留手动封面，插件生成的封面可以正常定时刷新。"
      },
      "covers_page_history_limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 200,
        "default": 50,
        "title": "生成记录保留数量"
      }
    }
  }
}
